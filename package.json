{
  "name": "sekai-zero-personal-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "cross-env DEPLOY_TARGET=github-pages vinext build && node scripts/prepare-pages.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "sync:anime": "node scripts/sync-anime-covers.mjs",
    "sync:games": "node scripts/sync-steam-library.mjs",
    "doctor": "node scripts/environment-doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:content": "node --test tests/content-invariants.test.mjs tests/environment-doctor.test.mjs tests/steam-snapshot-safety.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test:pages": "node --test tests/static-export.test.mjs",
    "test": "npm run build && npm run test:content && npm run test:render",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "check:pages": "cross-env PAGES_BASE_PATH=/sekai-zero NEXT_PUBLIC_BASE_PATH=/sekai-zero NEXT_PUBLIC_SITE_URL=https://miku-qaq.github.io/sekai-zero/ npm run build:pages && cross-env PAGES_BASE_PATH=/sekai-zero NEXT_PUBLIC_BASE_PATH=/sekai-zero NEXT_PUBLIC_SITE_URL=https://miku-qaq.github.io/sekai-zero/ npm run test:pages"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
